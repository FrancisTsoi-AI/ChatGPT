# Copy this file to `.env` (same folder) and fill it in. Never upload .env anywhere
# public, and never paste its contents into a chat.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Output of:  php private/bin/hash-passphrase.php   (or tools/hash.html if you have no PHP CLI)
# Paste it inside single quotes: it contains $ characters.
HB_PASSPHRASE_HASH=''

# Biggest single file you allow (MB). Large files upload in chunks automatically.
HB_MAX_FILE_MB=2048

# Days a device stays signed in, wrong tries before a pause, and the pause length.
HB_SESSION_DAYS=90
HB_LOGIN_MAX_TRIES=5
HB_LOGIN_PAUSE_MIN=15

# Days an item stays in the trash before it is purged for good.
HB_TRASH_DAYS=30

# Set to 1 to show PHP error details in API responses while setting up. Keep 0 in daily use.
HB_DEBUG=0
